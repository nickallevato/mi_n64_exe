diff --git a/src/tools/dxc-wine.sh b/src/tools/dxc-wine.sh
new file mode 100755
index 0000000..ad5c7cb
--- /dev/null
+++ b/src/tools/dxc-wine.sh
@@ -0,0 +1,14 @@
+#!/bin/sh
+# Run the Windows dxc.exe under Wine, converting absolute Linux paths in its arguments to Wine's Z: drive.
+# Used when cross-compiling for Windows from Linux, so DXIL comes from the same DXC as the shipped dxcompiler.dll.
+# Usage: dxc-wine.sh <wine> <dxc.exe> [dxc arguments...]
+wine="$1"; dxc="$2"; shift 2
+for arg in "$@"; do
+    case "$arg" in
+        -I/*/*) arg="-IZ:$(printf '%s' "${arg#-I}" | tr '/' '\\')" ;;
+        /*/*)   arg="Z:$(printf '%s' "$arg" | tr '/' '\\')" ;;
+    esac
+    set -- "$@" "$arg"
+    shift
+done
+WINEDEBUG=-all exec "$wine" "$dxc" "$@"
