diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index f1dd503..83fd8ee 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -2194,6 +2194,12 @@ namespace plume {
         immediatePresentModeSupported = std::find(presentModes.begin(), presentModes.end(), VK_PRESENT_MODE_IMMEDIATE_KHR) != presentModes.end();
         mailboxPresentModeSupported = std::find(presentModes.begin(), presentModes.end(), VK_PRESENT_MODE_MAILBOX_KHR) != presentModes.end();
 
+        // Prefer mailbox over FIFO for vsync: FIFO acquisition can block indefinitely while the window is hidden
+        // (e.g. NVIDIA on Wayland gets no frame callbacks for occluded surfaces), stalling the whole renderer.
+        if (mailboxPresentModeSupported && (requiredPresentMode == VK_PRESENT_MODE_FIFO_KHR)) {
+            requiredPresentMode = VK_PRESENT_MODE_MAILBOX_KHR;
+        }
+
         // Check if the format we requested is part of the supported surface formats.
         std::vector<VkSurfaceFormatKHR> compatibleSurfaceFormats;
         VkFormat requestedFormat = toVk(desc.format);
@@ -2412,9 +2418,9 @@ namespace plume {
         if (immediatePresentModeSupported && !vsyncEnabled) {
             requiredPresentMode = VK_PRESENT_MODE_IMMEDIATE_KHR;
         }
-        // FIFO is guaranteed to be supported.
+        // Mailbox doesn't block on presentation when the window is hidden; FIFO is guaranteed to be supported.
         else {
-            requiredPresentMode = VK_PRESENT_MODE_FIFO_KHR;
+            requiredPresentMode = mailboxPresentModeSupported ? VK_PRESENT_MODE_MAILBOX_KHR : VK_PRESENT_MODE_FIFO_KHR;
         }
     }
 
